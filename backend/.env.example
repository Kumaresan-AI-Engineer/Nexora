# Copy to backend/.env and fill in. Placeholders only: never commit real secrets.

# --- General -----------------------------------------------------------------
APP_NAME=PharmaSource
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Set true when served over HTTPS
COOKIE_SECURE=false

# --- Database ----------------------------------------------------------------
# Docker Compose default. For SQLite experiments: sqlite:///./pharmasource.db
DATABASE_URL=postgresql+psycopg://pharmasource:pharmasource@localhost:5432/pharmasource

# --- Vision providers (server-side only) ---------------------------------------
# Both the key AND the model name are required for a provider to be "configured".
# Choose model ids from the provider's current documentation; none are hardcoded.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
PROVIDER_TIMEOUT_SECONDS=60

# --- Uploads -------------------------------------------------------------------
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=40000000
IMAGE_MAX_SIDE=1600

# --- Web discovery (optional) -------------------------------------------------
# Tavily is used for candidate discovery only; results are never "verified" from snippets.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=8
PAGE_FETCH_TIMEOUT_SECONDS=10
PAGE_FETCH_MAX_BYTES=1500000
RESPECT_ROBOTS=true
# Identify your crawler honestly; include a contact
HTTP_USER_AGENT=PharmaSourceBot/0.1 (+contact: you@example.com)

# --- Currency ------------------------------------------------------------------
# none | static | frankfurter   (none = no conversion; foreign-currency offers are flagged)
FX_PROVIDER=none
# For FX_PROVIDER=static, e.g. USD>INR=83.10,EUR>INR=90.20 (you are responsible for freshness)
FX_STATIC_RATES=
INDIA_CURRENCY=INR
GLOBAL_CURRENCY=USD

# --- Search workflow -------------------------------------------------------------
# Serve clearly-labelled FICTIONAL demonstration offers (for testing the UI only)
DEMO_MODE=false
SOURCE_TIMEOUT_SECONDS=20
SOURCE_MAX_RETRIES=1
SOURCE_MAX_CONCURRENCY=4
SEARCH_TIMEOUT_SECONDS=120
MAX_CONCURRENT_SEARCHES_PER_SESSION=3
OFFER_MAX_AGE_HOURS=24
RATE_LIMIT_PER_MINUTE=30
IDENTIFY_RATE_LIMIT_PER_MINUTE=10

# Optional CSV of regulatory ceiling prices (see docs/SUPPLIER_CONNECTORS.md)
REFERENCE_DATA_CSV=
